# =============================================================================
#  Novel Cleaner — environment template.
#  Copy to `.env` (already gitignored) and fill in real values for your stack.
# =============================================================================

# --- Image / port ------------------------------------------------------------
NOVELCLEANER_IMAGE=ghcr.io/buco7854/novel-cleaner:latest
NOVELCLEANER_PORT=8080

# --- Storage -----------------------------------------------------------------
# Where the SQLite DB and Data Protection keys live (inside the container).
NOVELCLEANER_DATA_DIR=/data
# Where uploaded EPUBs and cleaned outputs live (inside the container).
NOVELCLEANER_BOOKS_DIR=/books
# Per-file upload limit (200 MB default).
NOVELCLEANER_MAX_UPLOAD_BYTES=209715200

# --- Local password auth -----------------------------------------------------
# Allow username/password sign-in. Set to "false" for SSO-only deployments.
# If you turn this off without a working OIDC config, the app force-enables it
# back at startup so the instance can't lock itself out.
NOVELCLEANER_PASSWORD_AUTH_ENABLED=true

# Optional bootstrap admin. Set BOTH to seed an admin on first startup; leave
# either blank and the app shows the first-run setup page instead so you can
# create the admin interactively. The defaults below are empty on purpose.
NOVELCLEANER_FIRST_ADMIN_EMAIL=
NOVELCLEANER_FIRST_ADMIN_PASSWORD=

# --- Reverse-proxy trust ----------------------------------------------------
# By default the app trusts X-Forwarded-* headers from loopback and from any
# RFC 1918 / IPv6-ULA private address (covers Docker bridges, k8s pod nets,
# typical home-LAN proxies). Add extra ranges or specific IPs here when your
# proxy lives outside those ranges.
#
# Comma-separated. Accepts bare IPs (1.2.3.4) or CIDRs (1.2.3.0/24, 2001:db8::/32).
# To trust ANY proxy (single-tenant, fully under your control), set
# KNOWN_NETWORKS to "0.0.0.0/0,::/0".
NOVELCLEANER_FORWARDED_KNOWN_NETWORKS=
NOVELCLEANER_FORWARDED_KNOWN_PROXIES=

# --- OPDS --------------------------------------------------------------------
# Allow OPDS connections to private/loopback/link-local addresses. Useful when
# your OPDS server (Calibre, Kavita, etc.) lives on the same LAN as this app.
# Leave blank or "false" to keep the SSRF guard active.
NOVELCLEANER_OPDS_ALLOW_PRIVATE_NETWORKS=false

# --- OIDC --------------------------------------------------------------------
NOVELCLEANER_OIDC_ENABLED=

# --- Common to all OIDC modes ---
NOVELCLEANER_OIDC_CLIENT_ID=
NOVELCLEANER_OIDC_CLIENT_SECRET=
# Human-readable provider name for the login page button, e.g. "Authentik",
# "Okta", "your company SSO". Default "single sign-on".
NOVELCLEANER_OIDC_DISPLAY_NAME=
# Comma-separated indices via numbered vars in compose (Auth__Oidc__Scopes__0..N)
# To set scopes, add them as Auth__Oidc__Scopes__0, ..__1 in your `.env` directly;
# the compose file forwards anything matching Auth__Oidc__*.

# --- Discovery (recommended) -------------------------------------------------
# Set ONE of the two below.
#
# AUTHORITY = issuer URL WITHOUT /.well-known/openid-configuration. The app
# appends it for you. Use this 99% of the time.
#   Keycloak           https://keycloak.example.com/realms/main
#   Authentik          https://authentik.example.com/application/o/novel-cleaner/
#   Google             https://accounts.google.com
#   Microsoft Entra ID https://login.microsoftonline.com/<tenant-id>/v2.0
NOVELCLEANER_OIDC_AUTHORITY=

# METADATA_ADDRESS = full discovery URL INCLUDING /.well-known/openid-configuration.
# Only needed when your IdP exposes discovery on a non-standard path.
#   e.g. https://idp.example.com/custom/path/.well-known/openid-configuration
NOVELCLEANER_OIDC_METADATA_ADDRESS=

# --- Manual endpoints (advanced) — leave blank if you set AUTHORITY/METADATA_ADDRESS above ---
NOVELCLEANER_OIDC_ISSUER=
NOVELCLEANER_OIDC_AUTHORIZATION_ENDPOINT=
NOVELCLEANER_OIDC_TOKEN_ENDPOINT=
NOVELCLEANER_OIDC_USERINFO_ENDPOINT=
NOVELCLEANER_OIDC_JWKS_URI=
NOVELCLEANER_OIDC_END_SESSION_ENDPOINT=

# --- Group → role mapping (optional) ----------------------------------------
# Every authenticated OIDC user automatically gets the User role.
NOVELCLEANER_OIDC_GROUPS_CLAIM=groups
# IdP group whose members are granted the Admin role on login. Leave empty to
# manage admin promotions manually (manual promotions persist across logins).
NOVELCLEANER_OIDC_ADMIN_GROUP=
# IdP group whose members are granted the BookDrop permission (allows the app
# to push their cleaned books into the configured drop folder, and shows the
# manual "Copy to drop folder" button on their job pages).
# Only consulted when NOVELCLEANER_DEFAULT_BOOK_DROP=false; otherwise everyone
# already has the permission.
NOVELCLEANER_OIDC_DROP_GROUP=
NOVELCLEANER_OIDC_AUTO_PROVISION=true

# --- Default permissions ----------------------------------------------------
# When true (default), every authenticated user has the BookDrop permission.
# Set to "false" to require explicit BookDrop role membership (granted via the
# OIDC group above, or directly in the database for password-only setups).
# Admins always have the permission regardless of this setting.
NOVELCLEANER_DEFAULT_BOOK_DROP=true
